      "namedRegex": "^/api/auth/login(?:/)?$"
    },
    {
      "page": "/api/auth/logout",
      "regex": "^/api/auth/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/logout(?:/)?$"
    },
    {
      "page": "/api/auth/me",
      "regex": "^/api/auth/me(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/me(?:/)?$"
    },
    {
      "page": "/api/menus",
      "regex": "^/api/menus(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/menus(?:/)?$"
    },
    {
      "page": "/api/pages",
      "regex": "^/api/pages(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/pages(?:/)?$"
    },
    {
      "page": "/api/snippets",
      "regex": "^/api/snippets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/snippets(?:/)?$"
    },
    {
      "page": "/api/users",
      "regex": "^/api/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/users(?:/)?$"
    },
    {
      "page": "/api/websites",
      "regex": "^/api/websites(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/websites(?:/)?$"
