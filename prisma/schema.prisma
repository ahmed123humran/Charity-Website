generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int           @id @default(autoincrement())
  email      String?       @unique
  name       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  password   String
  phone      String?       @unique
  role       Role          @default(ADMIN)
  activities ActivityLog[]
  footers    Footer[]
  pages      Page[]
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  details    String?
  oldData    Json?
  newData    Json?
  userId     Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Website {
  id          String   @id @default(cuid())
  domain      String?  @unique
  themeColor  String   @default("#714B67")
  secondaryColor String @default("#F59E0B")
  fontFamily  String   @default("Inter")
  language    String   @default("en_US")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        Json
  description Json?
  logo        String?
  footers     Footer[]
  menus       Menu[]
  pages       Page[]
}

model SocialMedia {
  id        String   @id @default(cuid())
  name      Json?
  url       String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  url         String
  isPublished Boolean  @default(false)
  websiteId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int?
  title       Json
  content     Json?
  menus       Menu[]
  user        User?    @relation(fields: [userId], references: [id])
  website     Website  @relation(fields: [websiteId], references: [id])

  @@unique([url, websiteId], name: "url_websiteId")
}

model Footer {
  id          String   @id @default(cuid())
  isPublished Boolean  @default(false)
  websiteId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int?
  title       Json
  content     Json?
  user        User?    @relation(fields: [userId], references: [id])
  website     Website  @relation(fields: [websiteId], references: [id])
}

model Menu {
  id         String  @id @default(cuid())
  url        String
  sequence   Int     @default(0)
  parentId   String?
  websiteId  String
  name       Json
  pageId     String?
  page       Page?   @relation(fields: [pageId], references: [id])
  parent     Menu?   @relation("SubMenus", fields: [parentId], references: [id])
  childMenus Menu[]  @relation("SubMenus")
  website    Website @relation(fields: [websiteId], references: [id])
}

model Snippet {
  id            String          @id @default(cuid())
  name          String
  category      String
  htmlContent   String
  thumbnail     String?
  nameAr        String?
  type          SnippetType     @default(STATIC)
  apiEndpoint   String?
  swiperConfig  Json?
  fieldMapping  Json?
  categoryId    String?
  containerType String          @default("contained")
  contentCategory ContentCategory? @relation(fields: [categoryId], references: [id])
}

model ContentCategory {
  id        String           @id @default(cuid())
  name      String
  nameAr    String?
  contents  DynamicContent[]
  snippets  Snippet[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model DynamicContent {
  id            String          @id @default(cuid())
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  image         String?
  images        String[]        @default([])
  categoryId    String
  publishDate   DateTime?       @default(now())
  category      ContentCategory @relation(fields: [categoryId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum SnippetType {
  STATIC
  DYNAMIC
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
